"""Pytest configuration and fixtures for model governance tests."""

from typing import Any

import pytest


# Verbosity levels: 0=low, 1=medium, 2=high
VERBOSITY_LEVEL = 1  # Default to medium


def pytest_addoption(parser):
    """Add custom command line options to pytest."""
    parser.addoption(
        "--verbosity-level",
        "-V",
        action="store",
        default="1",
        choices=["0", "1", "2"],
        help="Test verbosity level: 0=low (minimal), 1=medium (standard), 2=high (detailed)",
    )


def pytest_configure(config):
    """Configure pytest based on options."""
    global VERBOSITY_LEVEL
    VERBOSITY_LEVEL = int(config.getoption("--verbosity-level", "1"))


@pytest.fixture
def verbosity():
    """Get the current verbosity level."""
    return VERBOSITY_LEVEL


@pytest.fixture
def test_output(verbosity):
    """Get a TestOutput helper for the current verbosity level."""
    return TestOutput(verbosity)


class TestOutput:
    """Helper class for formatted test output based on verbosity.

    Verbosity levels:
    - 0 (low): Minimal output, only pass/fail indicators
    - 1 (medium): Standard test output with summaries
    - 2 (high): Full input/output details, all objects, warnings, errors
    """

    def __init__(self, verbosity: int):
        self.verbosity = verbosity

    def print_separator(self, char: str = "=", length: int = 80) -> None:
        """Print a separator line if verbosity >= 1."""
        if self.verbosity >= 1:
            print(char * length)

    def print_section(self, title: str) -> None:
        """Print a section header if verbosity >= 1."""
        if self.verbosity >= 1:
            print(f"\n{'=' * 80}")
            print(f"  {title}")
            print('=' * 80)

    def print_subsection(self, title: str) -> None:
        """Print a subsection header if verbosity >= 2."""
        if self.verbosity >= 2:
            print(f"\n--- {title} ---")

    def print_input(self, label: str, value: Any) -> None:
        """Print input data with full details in high verbosity."""
        if self.verbosity == 0:
            return  # Low verbosity: no input details

        if self.verbosity == 1:
            # Medium: show basic info
            if isinstance(value, str):
                preview = value[:100] + "..." if len(value) > 100 else value
                print(f"[INPUT] {label}: {preview}")
            elif hasattr(value, 'value'):
                # Handle EnforcementMode enum
                print(f"[INPUT] {label}: {value.value}")
            else:
                print(f"[INPUT] {label}: {value}")
        else:
            # High: show full details
            print(f"\n[INPUT] {label}:")
            if isinstance(value, str):
                print(f"  Type: str")
                print(f"  Length: {len(value)} characters")
                print(f"  Content: {repr(value)}")
            elif hasattr(value, 'value'):
                # Handle EnforcementMode enum
                print(f"  Type: {type(value).__name__}")
                print(f"  Value: {value.value}")
            elif isinstance(value, dict):
                print(f"  Type: dict")
                print(f"  Keys: {list(value.keys())}")
            else:
                print(f"  Value: {repr(value)}")

    def print_output(self, label: str, value: Any) -> None:
        """Print output data with full details in high verbosity."""
        if self.verbosity == 0:
            return  # Low verbosity: minimal output

        if self.verbosity == 1:
            # Medium: show basic info
            if hasattr(value, 'success'):
                status = "PASS" if value.success else "FAIL"
                warnings_info = ""
                if hasattr(value, 'warnings') and value.warnings:
                    warnings_info = f", {len(value.warnings)} warnings"
                if hasattr(value, 'errors') and value.errors:
                    errors_info = f", {len(value.errors)} errors"
                print(f"[OUTPUT] {label}: {status}{warnings_info}{errors_info}")
            elif isinstance(value, str):
                preview = value[:100] + "..." if len(value) > 100 else value
                print(f"[OUTPUT] {label}: {preview}")
            else:
                print(f"[OUTPUT] {label}: {value}")
        else:
            # High: show full details
            print(f"\n[OUTPUT] {label}:")
            if hasattr(value, '__dict__'):
                for key, val in value.__dict__.items():
                    if isinstance(val, (str, int, bool, float)) or val is None:
                        print(f"  {key}: {repr(val)}")
                    elif isinstance(val, list):
                        if val:
                            print(f"  {key}: [list with {len(val)} items]")
                            if self.verbosity >= 2:
                                for i, item in enumerate(val[:10]):  # Show first 10
                                    print(f"    [{i}]: {repr(item)}")
                                if len(val) > 10:
                                    print(f"    ... and {len(val) - 10} more")
                        else:
                            print(f"  {key}: []")
                    elif isinstance(val, dict):
                        if val:
                            print(f"  {key}: {{dict with {len(val)} keys}}")
                            if self.verbosity >= 2:
                                for k, v in list(val.items())[:10]:
                                    print(f"    {k}: {repr(v)}")
                                if len(val) > 10:
                                    print(f"    ... and {len(val) - 10} more keys")
                        else:
                            print(f"  {key}: {{}}")
                    else:
                        print(f"  {key}: {type(val).__name__}")
            elif isinstance(value, dict):
                import json
                print(f"  {json.dumps(value, indent=2, default=str)}")
            elif isinstance(value, str):
                print(f"  Content: {repr(value)}")
                print(f"  Length: {len(value)} characters")
            else:
                print(f"  Value: {repr(value)}")

    def print_warnings(self, warnings: list) -> None:
        """Print all warnings in medium or high verbosity."""
        if self.verbosity >= 1 and warnings:
            if self.verbosity == 1:
                first = warnings[0] if warnings else 'none'
                print(f"[WARNINGS] {len(warnings)} warning(s): {first}")
            else:
                print(f"\n[WARNINGS] {len(warnings)} warning(s):")
                for i, warning in enumerate(warnings):
                    print(f"  [{i+1}] {warning}")

    def print_errors(self, errors: list) -> None:
        """Print all errors in medium or high verbosity."""
        if self.verbosity >= 1 and errors:
            if self.verbosity == 1:
                first = errors[0] if errors else 'none'
                print(f"[ERRORS] {len(errors)} error(s): {first}")
            else:
                print(f"\n[ERRORS] {len(errors)} error(s):")
                for i, error in enumerate(errors):
                    print(f"  [{i+1}] {error}")

    def print_metadata(self, metadata: dict) -> None:
        """Print metadata in high verbosity."""
        if self.verbosity >= 2 and metadata:
            print(f"\n[METADATA]:")
            for key, val in metadata.items():
                if isinstance(val, (str, int, bool, float)) or val is None:
                    print(f"  {key}: {repr(val)}")
                elif isinstance(val, list):
                    print(f"  {key}: [list with {len(val)} items]")
                elif isinstance(val, dict):
                    print(f"  {key}: {{dict with {len(val)} keys}}")
                else:
                    print(f"  {key}: {type(val).__name__}")

    def print_pass(self, message: str) -> None:
        """Print pass message."""
        if self.verbosity >= 1:
            print(f"✓ {message}")

    def print_fail(self, message: str) -> None:
        """Print fail message."""
        if self.verbosity >= 1:
            print(f"✗ {message}")


